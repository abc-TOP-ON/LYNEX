		end
		
		execBtn.Text = "EXECUTE"
		execBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
	end
	
	execBtn.MouseButton1Click:Connect(executeScript)
	execBtn.TouchTap:Connect(executeScript)
	
