local function createRedTextGradient(parentFrame)
	local Gradient = Instance.new("UIGradient")
	Gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 90, 90)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(130, 0, 0)),
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(255, 90, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
	})
	Gradient.Parent = parentFrame
	return Gradient
end

