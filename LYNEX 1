-- دالة تحديث قائمة السكربتات
function refreshScripts()
	if scrollContainer then
		scrollContainer:Destroy()
	end
	
	scrollContainer = Instance.new("ScrollingFrame")
	scrollContainer.Size = UDim2.new(1, 0, 0, 340)
	scrollContainer.Position = UDim2.new(0, 0, 0, 158)
	scrollContainer.BackgroundTransparency = 1
	scrollContainer.BorderSizePixel = 0
	scrollContainer.ScrollBarThickness = 4
	scrollContainer.ScrollBarImageColor3 = Color3.fromRGB(180, 0, 0)
	scrollContainer.Parent = InsideFrame
	
	buttonHolder = Instance.new("Frame")
	buttonHolder.Size = UDim2.new(1, 0, 0, #scriptList * 90 + 20)
	buttonHolder.Position = UDim2.new(0, 0, 0, 0)
	buttonHolder.BackgroundTransparency = 1
	buttonHolder.Parent = scrollContainer
	
	scrollContainer.CanvasSize = UDim2.new(0, 0, 0, #scriptList * 90 + 20)
	
	-- إنشاء الأزرار
	local allGrads = {}
	for i, scriptData in ipairs(scriptList) do
		local yPos = (i - 1) * 90 + 5
		local grads = createScriptButton(buttonHolder, yPos, scriptData.name, scriptData.desc, scriptData.url, i)
		table.insert(allGrads, grads)
	end
	
	-- تحريك التدرجات
	for _, grads in ipairs(allGrads) do
		if grads.nameGrad then animate(grads.nameGrad, 2) end
		if grads.execGrad then animate(grads.execGrad, 1.5) end
		if grads.redBorderGrad then animate(grads.redBorderGrad, 3) end
	end
end

-- دالة التحريك العالمية
local function animate(targetGradient, speed)
	if targetGradient then
		local Tween = TweenService:Create(targetGradient, TweenInfo.new(speed, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
		Tween:Play()
	end
end

