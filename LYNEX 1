-- متغير لحالة السكربت
local scriptStatus = "IDLE" -- IDLE, LOADING, SUCCESS, ERROR

-- دالة تحديث حالة الزر
local function updateStatus(status, message)
	scriptStatus = status
	if status == "IDLE" then
		StatusButton.Text = "⚡ IDLE"
		StatusButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		StatusButton.TextColor3 = Color3.fromRGB(200, 200, 200)
	elseif status == "LOADING" then
		StatusButton.Text = "⏳ LOADING..."
		StatusButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
		StatusButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	elseif status == "SUCCESS" then
		StatusButton.Text = "✅ " .. (message or "SUCCESS")
		StatusButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
		StatusButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		-- إعادة تعيين تلقائياً بعد 3 ثواني
		task.wait(3)
		if scriptStatus == "SUCCESS" then
			updateStatus("IDLE")
		end
	elseif status == "ERROR" then
		StatusButton.Text = "❌ " .. (message or "ERROR")
		StatusButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
		StatusButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		-- إعادة تعيين تلقائياً بعد 3 ثواني
		task.wait(3)
		if scriptStatus == "ERROR" then
			updateStatus("IDLE")
		end
	end
end

-- وظيفة تحميل وتنفيذ السكربت من الرابط
local function loadAndExecuteScript()
	if scriptStatus == "LOADING" then
		return -- منع التحميل المتكرر
	end
	
	updateStatus("LOADING")
	
	local success, result = pcall(function()
		local scriptUrl = "https://raw.githubusercontent.com/abc-TOP-ON/LYNEX/refs/heads/main/LYNEX%201"
		local scriptContent = game:HttpGet(scriptUrl)
		return scriptContent
	end)
	
	if success and result then
		local loadSuccess, execError = pcall(function()
			local func = loadstring(result)
			if func then
				func()
				return true
			else
				return false, "Invalid script format"
			end
		end)
		
		if loadSuccess then
			updateStatus("SUCCESS", "EXECUTED")
		else
			updateStatus("ERROR", "INVALID SCRIPT")
		end
	else
		updateStatus("ERROR", "NETWORK FAIL")
	end
end

-- ربط زر التنفيذ
ExecuteButton.MouseButton1Click:Connect(function()
	loadAndExecuteScript()
end)

