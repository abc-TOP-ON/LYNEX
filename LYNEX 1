local function updateStatistics(scriptName)
	statistics.scriptsExecuted = statistics.scriptsExecuted + 1
	statistics.totalExecutions = statistics.totalExecutions + 1
	statistics.lastExecuted = scriptName
end

local function getStatistics()
	local uptime = os.time() - statistics.startTime
	local hours = math.floor(uptime / 3600)
	local minutes = math.floor((uptime % 3600) / 60)
	local seconds = uptime % 60
	
	return {
		scriptsExecuted = statistics.scriptsExecuted,
		lastExecuted = statistics.lastExecuted,
		totalExecutions = statistics.totalExecutions,
		uptime = string.format("%02d:%02d:%02d", hours, minutes, seconds),
		favorites = #statistics.favoriteScripts
	}
end

