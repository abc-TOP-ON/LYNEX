local function createScriptButton(parent, data, yPos)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 70)
	btn.Position = UDim2.new(0.05, 0, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	btn.BorderSizePixel = 0
	btn.Parent = parent
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 10)
	btnCorner.Parent = btn
	
	-- عنوان السكربت
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -80, 0, 22)
	titleLabel.Position = UDim2.new(0, 12, 0, 8)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = data.title
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextSize = 14
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = btn
	
	-- وصف السكربت
	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(1, -80, 0, 18)
	descLabel.Position = UDim2.new(0, 12, 0, 32)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = data.desc
	descLabel.TextColor3 = Color3.fromRGB(130, 130, 130)
	descLabel.TextSize = 11
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.Parent = btn
	
	-- علامة (TAG)
	if data.tag then
		local tagLabel = Instance.new("TextLabel")
		tagLabel.Size = UDim2.new(0, 45, 0, 18)
		tagLabel.Position = UDim2.new(1, -55, 0, 8)
		tagLabel.BackgroundColor3 = Color3.fromRGB(40, 30, 30)
		tagLabel.Text = data.tag
		tagLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		tagLabel.TextSize = 9
		tagLabel.Font = Enum.Font.GothamBold
		tagLabel.TextXAlignment = Enum.TextXAlignment.Center
		tagLabel.Parent = btn
		local tagCorner = Instance.new("UICorner")
		tagCorner.CornerRadius = UDim.new(0, 4)
		tagCorner.Parent = tagLabel
	end
	
	-- زر EXECUTE
	local execBtn = Instance.new("TextButton")
	execBtn.Size = UDim2.new(0, 60, 0, 24)
	execBtn.Position = UDim2.new(1, -70, 0, 38)
	execBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
	execBtn.BorderSizePixel = 0
	execBtn.Text = "▶ EXEC"
	execBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	execBtn.TextSize = 10
	execBtn.Font = Enum.Font.GothamBold
	execBtn.Parent = btn
	local execCorner = Instance.new("UICorner")
	execCorner.CornerRadius = UDim.new(0, 6)
	execCorner.Parent = execBtn
	
	-- تنفيذ السكربت عند الضغط
	execBtn.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			local func = loadstring(data.script)
			if func then
				func()
				showNotification("✅ Script executed!", true)
			else
				error("Failed to load script")
			end
		end)
		if not success then
			showNotification("❌ Error: " .. tostring(err), false)
		end
	end)
	
	return btn
end

-- ========== نظام الإشعارات ==========
local function showNotification(msg, isSuccess)
	local notif = Instance.new("Frame")
	notif.Size = UDim2.new(0, 280, 0, 40)
	notif.Position = UDim2.new(0.5, -140, 1, -60)
	notif.BackgroundColor3 = isSuccess and Color3.fromRGB(30, 50, 30) or Color3.fromRGB(50, 30, 30)
	notif.BorderSizePixel = 0
	notif.Parent = ScreenGui
	local notifCorner = Instance.new("UICorner")
	notifCorner.CornerRadius = UDim.new(0, 8)
	notifCorner.Parent = notif
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = msg
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 13
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Parent = notif
	
	-- تأثير الظهور
	notif.Position = UDim2.new(0.5, -140, 1, 20)
	local tween = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
		Position = UDim2.new(0.5, -140, 1, -60)
	})
	tween:Play()
	
	task.wait(2.5)
	local tweenOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
		Position = UDim2.new(0.5, -140, 1, 20)
	})
	tweenOut:Play()
	task.wait(0.3)
	notif:Destroy()
end

