	local function executeScript()
		execBtn.Text = "⏳"
		execBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
		
		local success, result = pcall(function()
			return game:HttpGet(scriptUrl)
		end)
		
		if success and result then
			local loadSuccess, execError = pcall(function()
				local func = loadstring(result)
				if func then
					func()
					return true
				else
					return false
				end
			end)
			
			if loadSuccess then
				execBtn.Text = "✅"
				execBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
				task.wait(1.5)
			else
