-- ========== نظام إعادة الترتيب حسب اللعبة ==========
local function reorderByGame()
	local success, gameInfo = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId)
	end)
	
	if not success then return end
	
	local currentGame = gameInfo.Name
	local currentGameLower = string.lower(currentGame)
	
	local matchedIndex = nil
	for i, data in ipairs(buttonsData) do
		if data.game and string.find(currentGameLower, string.lower(data.game)) then
			matchedIndex = i
			break
		end
	end
	
	if matchedIndex and matchedIndex > 1 then
		local matchedData = table.remove(buttonsData, matchedIndex)
		table.insert(buttonsData, 1, matchedData)
		
		for i, data in ipairs(buttonsData) do
			data.y = 165 + (i - 1) * 128
		end
		
		CurrentGameLabel.Text = "🎯 Showing script: " .. matchedData.title .. " (for: " .. currentGame .. ")"
		showSideNotification("🎯 Showing: " .. matchedData.title, true)
	else
		CurrentGameLabel.Text = "🎮 Matching script will appear at the top"
	end
end

-- ========== الإحصائيات ==========
local function updateStatistics(scriptName)
	statistics.scriptsExecuted = statistics.scriptsExecuted + 1
	statistics.totalExecutions = statistics.totalExecutions + 1
	statistics.lastExecuted = scriptName
end

local function getStatistics()
	local uptime = os.time() - statistics.startTime
	local hours = math.floor(uptime / 3600)
	local minutes = math.floor((uptime % 3600) / 60)
	local seconds = uptime % 60
	
	return {
		scriptsExecuted = statistics.scriptsExecuted,
		lastExecuted = statistics.lastExecuted,
		totalExecutions = statistics.totalExecutions,
		uptime = string.format("%02d:%02d:%02d", hours, minutes, seconds),
		favorites = #statistics.favoriteScripts
	}
end

-- ========== معلومات السيرفر ==========
local function getServerInfo()
	local players = Players
	local stats = getStatistics()
	local gameInfo = MarketplaceService:GetProductInfo(game.PlaceId)
	
	return {
		GameName = gameInfo.Name,
		GameId = game.PlaceId,
		Players = #players:GetPlayers(),
		MaxPlayers = players.MaxPlayers,
		ServerTime = os.date("%H:%M:%S"),
		Uptime = stats.uptime,
		ExecutedScripts = stats.scriptsExecuted,
		LastScript = stats.lastExecuted
	}
end

