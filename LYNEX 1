-- 10. نظام تشغيل حركة الدوران اللانهائية لجميع التدرجات الحمراء المتوهجة
local function animate(targetGradient, speed)
	if targetGradient then
		local Tween = TweenService:Create(targetGradient, TweenInfo.new(speed, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
		Tween:Play()
	end
end

