-- ========== نظام البحث ==========
SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
	local searchText = string.lower(SearchBar.Text)
	
	for i, data in ipairs(buttonsData) do
		local frame = buttonFrames[i]
		if frame then
			local found = false
			-- البحث في العنوان
			if string.find(string.lower(data.title), searchText) then
				found = true
			end
			-- البحث في الوصف
			if not found and string.find(string.lower(data.desc), searchText) then
				found = true
			end
			-- البحث في الكلمات المفتاحية
			if not found then
				for _, keyword in ipairs(data.keywords) do
					if string.find(searchText, keyword) or string.find(keyword, searchText) then
						found = true
						break
					end
				end
			end
			-- إظهار أو إخفاء الزر
			frame.Visible = found or searchText == ""
		end
	end
end)

-- 12. نظام تشغيل حركة الدوران
local function animate(targetGradient, speed)
	if targetGradient then
		local Tween = TweenService:Create(targetGradient, TweenInfo.new(speed, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
		Tween:Play()
	end
end

